{
  "expo": {
    "name": "ChefMate AI",
    "slug": "chefmate-ai",
    "scheme": "chefmate",
    "version": "1.0.0",
    "platforms": ["ios", "android" , "web"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "ChefMate uses your photo library to scan fridge ingredients.",
          "cameraPermission": "ChefMate uses your camera to scan fridge ingredients."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ChefMate uses your microphone for voice cooking assistance."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.chefmate.mobile"
    },
    "android": {
      "package": "ai.chefmate.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },

  "expo": {
    "name": "ChefMate AI",
    "slug": "chefmate-ai",
    "scheme": "chefmate",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "extra": {
      "eas": {
        "projectId": "845ea349-df9f-4eeb-b306-d0842725e506"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]

}
  }
}
